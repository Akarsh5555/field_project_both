{
  "name": "fieldassist-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FieldAssist - Enterprise Sales Force Automation & Field Operations Monorepo",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "install:all": "npm --prefix frontend install && npm --prefix backend install",
    "lint:frontend": "npm --prefix frontend run lint",
    "auto-sync": "powershell -ExecutionPolicy Bypass -File ./auto_sync.ps1"
  },
  "keywords": [
    "fieldassist",
    "sales-force-automation",
    "react",
    "vite",
    "supabase",
    "drizzle-orm"
  ]
}
